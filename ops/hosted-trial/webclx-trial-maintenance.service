[Unit]
Description=Enforce webClx trial capacity and encrypted backup policy
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/webclx/hosted-trial-maintenance.sh run --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/webclx-trials /srv/webclx-trial-backups /var/lib/webclx-trial-maintenance
UMask=0077

